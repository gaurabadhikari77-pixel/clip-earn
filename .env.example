# ========================================================
# ClipEarn - Environment Configuration Variables
# ========================================================

# 1. Platform Owner Email(s)
# Any account signing in with this email automatically receives the Owner role (unlimited uploads, no credits needed)
# Multiple emails can be specified, separated by commas (e.g. "owner@clipearn.com,admin@clipearn.com")
OWNER_EMAIL=owner@clipearn.com

# 2. Firebase Backend Configuration (Auth, Firestore, Storage)
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyAKpF61DrBhuvOjtZBVHxewI2kOrslV9P8
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=clipearn-6ff40.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=clipearn-6ff40
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=clipearn-6ff40.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=1014656683711
NEXT_PUBLIC_FIREBASE_APP_ID=1:1014656683711:web:cc02f3ef28f6ab6d6e400a
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-NGMYFW1MWW

# 3. NextAuth Configuration
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=clipearn-super-secret-jwt-key-replace-in-production-32chars

